# Copy to .env and adjust. All optional.
PORT=3000
# Public address used in QR codes and links, e.g. https://siteroll.example.co.uk
PUBLIC_URL=
# true = show "Pretend I'm at…", the demo reset and on-screen codes. Never use in production.
DEMO_MODE=true
# 1 = serve over HTTPS with a self-signed certificate (lets phones on your Wi-Fi use real GPS)
HTTPS=
DB_PATH=data/siteroll.db

# Ask SiteRoll (AI assistant). Get a key at console.anthropic.com. Leave blank to switch it off.
ANTHROPIC_API_KEY=
# Most questions Ask SiteRoll will answer per day (protects a shared demo link from a big bill)
ASK_DAILY_LIMIT=300
# How hard Claude thinks before answering: low (fastest), medium or high
ASK_EFFORT=low

# WhatsApp and real texts through Twilio (see the README). Leave blank to simulate everything.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# e.g. whatsapp:+14155238886 for Twilio's WhatsApp sandbox
TWILIO_WHATSAPP_FROM=
# optional: a Twilio phone number for ordinary texts
TWILIO_SMS_FROM=
